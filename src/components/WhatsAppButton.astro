---
import { whatsappHref } from '../lib/content';
import Icon from './Icon.astro';
---

{/*
  Floating WhatsApp button, on every page. The original used a 12-frame
  animated whatsapp.gif; this is an inline SVG at render size instead
  (CLAUDE.md -> Images: icons are inline SVG, not oversized rasters).
*/}
<a
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  class="group fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-steel-900/25 transition-transform hover:scale-105 focus-visible:scale-105 sm:bottom-8 sm:right-8"
>
  <Icon name="whatsapp" size={30} />
  <span class="sr-only">Chat with us on WhatsApp</span>
</a>
