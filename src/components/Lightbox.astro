---
/**
 * One accessible image viewer per page, driving every `[data-lightbox]` link
 * on it (see Zoomable.astro), in document order.
 *
 * Native <dialog>: focus is trapped and Esc closes it for free. On top of
 * that: ←/→ keys, swipe, prev/next buttons, an "n / total" counter announced
 * politely, and focus returns to the thumbnail that opened it.
 */
import Icon from './Icon.astro';
---

<dialog
  id="lightbox"
  aria-label="Image viewer"
  class="lightbox on-dark m-0 h-dvh max-h-none w-full max-w-none bg-transparent p-0 text-white"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <p class="font-display text-lg tracking-wide text-steel-300" aria-live="polite" data-lb-counter></p>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center text-white hover:text-accent-400"
        data-lb-close
        aria-label="Close image viewer"
      >
        <Icon name="close" size={28} />
      </button>
    </div>

    <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-20" data-lb-stage>
      <figure class="flex h-full max-h-full w-full flex-col items-center justify-center">
        <img data-lb-img alt="" class="min-h-0 w-full flex-1 object-contain" />
        <figcaption class="px-4 pt-3 pb-4 text-center text-sm text-steel-300" data-lb-caption></figcaption>
      </figure>

      <button
        type="button"
        class="absolute top-1/2 left-1 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center bg-steel-950/60 text-white hover:text-accent-400 sm:left-4"
        data-lb-prev
        aria-label="Previous image"
      >
        <Icon name="chevron" size={28} class="rotate-90" />
      </button>
      <button
        type="button"
        class="absolute top-1/2 right-1 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center bg-steel-950/60 text-white hover:text-accent-400 sm:right-4"
        data-lb-next
        aria-label="Next image"
      >
        <Icon name="chevron" size={28} class="-rotate-90" />
      </button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]'));

  if (dialog && links.length) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const multi = links.length > 1;
    prev.hidden = !multi;
    next.hidden = !multi;

    function preload(i: number) {
      const l = links[(i + links.length) % links.length];
      if (l) new Image().src = l.dataset.lbSrc!;
    }

    function show(i: number) {
      index = (i + links.length) % links.length;
      const l = links[index];
      img.src = l.dataset.lbSrc!;
      img.width = Number(l.dataset.lbWidth);
      img.height = Number(l.dataset.lbHeight);
      img.alt = l.dataset.lbAlt ?? '';
      caption.textContent = l.dataset.lbCaption ?? '';
      caption.hidden = !caption.textContent;
      counter.textContent = multi ? `${index + 1} / ${links.length}` : '';
      if (multi) {
        preload(index + 1);
        preload(index - 1);
      }
    }

    function open(i: number, from: HTMLElement) {
      opener = from;
      show(i);
      dialog!.showModal();
      document.documentElement.style.overflow = 'hidden';
    }

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      img.removeAttribute('src');
      opener?.focus();
    });

    links.forEach((l, i) =>
      l.addEventListener('click', (e) => {
        // Let modified clicks (new tab etc.) behave like a normal link.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        open(i, l);
      }),
    );

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());

    // Click on the dark backdrop area (not the image or a control) closes.
    stage.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === stage || t.tagName === 'FIGURE') dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (!multi) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(index + 1);
      }
    });

    // Swipe: a mostly-horizontal drag of 50px or more.
    let x0 = 0;
    let y0 = 0;
    stage.addEventListener(
      'touchstart',
      (e) => {
        x0 = e.changedTouches[0].clientX;
        y0 = e.changedTouches[0].clientY;
      },
      { passive: true },
    );
    stage.addEventListener(
      'touchend',
      (e) => {
        if (!multi) return;
        const dx = e.changedTouches[0].clientX - x0;
        const dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }
</script>

<style>
  .lightbox::backdrop {
    background: rgb(11 17 32 / 0.95);
  }
</style>
