---
import { site, tel, phoneDisplay, emails, mapsLink } from '../lib/content';
import { FOOTER_NAV } from '../lib/nav';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

{/*
  The original footer had four dead "##" links and five empty "#" social
  links. The contact rows are now real tel:/mailto:/map links; the social
  links are removed (no accounts on record). CLAUDE.md -> Broken mechanics.
  JSX-style comment so it is stripped from the output, not shipped.
*/}
<footer class="on-dark bg-steel-950 text-steel-300">
  <div class="shell grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
    <!-- About -->
    <div>
      <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-white">
        {site.footer.about_heading}
      </h2>
      <span class="mt-3 block h-0.5 w-10 bg-accent-500"></span>
      <p class="mt-4 text-sm leading-relaxed text-steel-400">
        {site.footer.about_text}
      </p>
    </div>

    <!-- Link columns, straight from site.json -->
    {
      Object.entries(FOOTER_NAV).map(([heading, links]) => (
        <nav aria-label={heading}>
          <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-white">
            {heading}
          </h2>
          <span class="mt-3 block h-0.5 w-10 bg-accent-500"></span>
          <ul class="mt-4 space-y-2.5 text-sm">
            {links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="inline-flex items-center gap-2 text-steel-400 transition-colors hover:text-accent-400"
                >
                  <Icon name="chevron" size={14} class="-rotate-90 text-accent-500" />
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <!-- Get in Touch -->
    <div>
      <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-white">
        {site.footer.get_in_touch_heading}
      </h2>
      <span class="mt-3 block h-0.5 w-10 bg-accent-500"></span>
      <ul class="mt-4 space-y-3.5 text-sm">
        <li class="flex items-start gap-3">
          <Icon name="person" size={18} class="mt-0.5 shrink-0 text-accent-500" />
          <span class="text-steel-300">{site.contact.person}</span>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="phone" size={18} class="mt-0.5 shrink-0 text-accent-500" />
          <a href={tel} class="text-steel-300 hover:text-accent-400">{phoneDisplay}</a>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="mail" size={18} class="mt-0.5 shrink-0 text-accent-500" />
          <span class="flex flex-col gap-1">
            {
              emails.map((e) => (
                <a href={`mailto:${e}`} class="break-all text-steel-300 hover:text-accent-400">
                  {e}
                </a>
              ))
            }
          </span>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-accent-500" />
          <a
            href={mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="leading-relaxed text-steel-300 hover:text-accent-400"
          >
            {site.contact.address.full_footer}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-steel-800">
    <div class="shell py-6 text-xs text-steel-500">
      <p>
        &copy; Copyright <span data-copyright-year>{year}</span>
        <strong class="font-semibold text-steel-400">{site.company_name}</strong>. All Rights
        Reserved
      </p>
    </div>
  </div>
</footer>

<script>
  // The year is written at build time; refresh it in the browser so a static
  // build never shows a stale year.
  document.querySelectorAll('[data-copyright-year]').forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>
