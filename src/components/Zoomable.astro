---
/**
 * A photo that opens full-size in the shared <Lightbox>. Without JS it is a
 * plain link to the full-size image, so it still works.
 */
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  /** Shown under the image in the lightbox. Defaults to the alt text. */
  caption?: string;
  eager?: boolean;
  class?: string;
  /** Classes for the clickable wrapper. */
  linkClass?: string;
}
const { src, alt, caption, linkClass = '', ...photo } = Astro.props;

// Full-size view: never wider than the original, capped at 1600px.
const full = await getImage({ src, format: 'webp', width: Math.min(src.width, 1600) });
---

<a
  href={full.src}
  class:list={['group relative block overflow-hidden', linkClass]}
  data-lightbox
  data-lb-src={full.src}
  data-lb-width={full.attributes.width}
  data-lb-height={full.attributes.height}
  data-lb-alt={alt}
  data-lb-caption={caption ?? alt}
>
  <Photo src={src} alt={alt} {...photo} />
  <span
    class="pointer-events-none absolute right-2 bottom-2 inline-flex h-9 w-9 items-center justify-center bg-steel-950/70 text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
    aria-hidden="true"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5M10.5 7.5v6M7.5 10.5h6"></path></svg>
  </span>
</a>
