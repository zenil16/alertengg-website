---
import PageLayout from '../layouts/PageLayout.astro';
import Zoomable from '../components/Zoomable.astro';
import Icon from '../components/Icon.astro';
import { headings, figures, img } from '../lib/content';

const SLUG = 'Casting-Design';
const [, exampleTitle] = headings(SLUG, 2);

// The four `####` lines sit directly under the H1 in the original (an H4 under
// an H1). They are a list of key points, so they render as one — heading order
// stays valid and the words are unchanged.
const points = headings(SLUG, 4);

// Casting → Hot Spot Analysis → Feeder Design, in captured order.
const steps = figures(SLUG).map((f) => ({
  ...f,
  alt: `${f.heading}: ${f.text[0]}`,
}));
---

<PageLayout slug={SLUG} description={points[0]} lightbox>
  <section class="shell section">
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        points.map((p) => (
          <li class="flex gap-4 border border-steel-200 border-l-4 border-l-accent-500 bg-white p-5">
            <Icon name="shield" size={24} class="mt-0.5 shrink-0 text-accent-700" />
            <span class="font-medium leading-relaxed text-steel-800">{p}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-steel-200 bg-steel-50">
    <div class="shell section">
      <h2 class="eyebrow-rule max-w-4xl text-2xl text-steel-900 sm:text-3xl">{exampleTitle}</h2>

      <ol class="mt-12 grid gap-10 lg:grid-cols-3 lg:gap-8">
        {
          steps.map((s, i) => (
            <li class="relative">
              <article class="flex h-full flex-col border border-steel-200 bg-white">
                <Zoomable
                  src={img(s.src)}
                  alt={s.alt}
                  caption={s.alt}
                  widths={[300]}
                  sizes="300px"
                  linkClass="flex justify-center bg-white p-4"
                  class="h-auto w-full max-w-[300px]"
                />
                <div class="flex-1 border-t-2 border-accent-500 px-5 py-5">
                  <p class="font-display text-sm font-semibold uppercase tracking-widest text-accent-700">
                    <span class="sr-only">Step </span>
                    {String(i + 1).padStart(2, '0')}
                  </p>
                  <h3 class="card-title mt-1">{s.heading}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-steel-700">{s.text[0]}</p>
                </div>
              </article>
              {i < steps.length - 1 && (
                <span
                  aria-hidden="true"
                  class="absolute left-1/2 -bottom-9 z-10 flex h-8 w-8 -translate-x-1/2 rotate-90 items-center justify-center bg-accent-700 text-white lg:top-1/3 lg:-right-7 lg:bottom-auto lg:left-auto lg:translate-x-0 lg:rotate-0"
                >
                  <Icon name="arrow" size={18} />
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</PageLayout>
